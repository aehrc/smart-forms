{
  "name": "@aehrc/questionnaire-test-toolkit",
  "version": "0.1.0",
  "description": "Behavioural test toolkit for FHIR Questionnaire forms: DOM interaction helpers and a renderer harness.",
  "scripts": {
    "compile": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "watch": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap --watch",
    "build": "npm run compile",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aehrc/smart-forms.git",
    "directory": "packages/questionnaire-test-toolkit"
  },
  "author": "AEHRC",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/aehrc/smart-forms/issues"
  },
  "homepage": "https://github.com/aehrc/smart-forms#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aehrc/sdc-populate": "^4.7.1",
    "@aehrc/sdc-template-extract": "^1.0.15",
    "@testing-library/user-event": "^14.6.1",
    "@types/fhir": "^0.0.41",
    "fhirpath": "^4.10.1"
  },
  "peerDependencies": {
    "@aehrc/smart-forms-renderer": "^1.4.0",
    "@tanstack/react-query": "^5.90.5",
    "@testing-library/dom": "^10.4.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@aehrc/smart-forms-renderer": "^1.4.0",
    "@tanstack/react-query": "^5.90.5",
    "@testing-library/dom": "^10.4.0",
    "@types/react": "^18.3.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
