# Copy this file to .env and update the values to match your environment

# FHIR server used to resolve questionnaireRef and context references.
# Leave empty to only accept the Questionnaire and context as resources in the request.
EHR_SERVER_URL=
EHR_SERVER_AUTH_TOKEN=

# Leave empty to use the default terminology server of sdc-populate (https://tx.ontoserver.csiro.au/fhir)
TERMINOLOGY_SERVER_URL=https://r4.ontoserver.csiro.au/fhir
TERMINOLOGY_SERVER_AUTH_TOKEN=

# Comma-separated base URLs of other servers that absolute URLs in requests may point at (optional)
ALLOWED_FETCH_ORIGINS=
